REXFY_ENV=local
REXFY_DATABASE_URL=postgresql+psycopg://rexfy:rexfy@localhost:5432/rexfy
REXFY_REDIS_URL=redis://localhost:6379/0
REXFY_CORS_ORIGINS=["http://localhost:3000"]
# From the Clerk dashboard: API keys (Frontend API URL and Secret key)
REXFY_CLERK_ISSUER=https://your-app.clerk.accounts.dev
REXFY_CLERK_SECRET_KEY=sk_test_...
# Where browsers reach this API (links to locally stored photos)
REXFY_PUBLIC_API_URL=http://localhost:8000
# Photos: "local" saves them in ./uploads; "s3" uses an S3-compatible bucket (S3, R2, MinIO);
# "vercel_blob" uses the project's Blob store (Vercel sets BLOB_READ_WRITE_TOKEN).
REXFY_STORAGE_BACKEND=local
# REXFY_S3_BUCKET=rexfy-uploads
# REXFY_S3_PUBLIC_URL=https://cdn.rexfy.co
# REXFY_S3_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com
# REXFY_S3_ACCESS_KEY_ID=...
# REXFY_S3_SECRET_ACCESS_KEY=...
# Background jobs (emails): "rq" needs `uv run python -m app.worker` running; "inline" sends
# them during the request, handy locally without a worker.
REXFY_TASK_QUEUE=rq
REXFY_PUBLIC_WEB_URL=http://localhost:3000
# Without SMTP, emails are only written to the worker's log.
# REXFY_SMTP_HOST=smtp.resend.com
# REXFY_SMTP_USER=resend
# REXFY_SMTP_PASSWORD=...
# REXFY_EMAIL_FROM=RexFy <notificaciones@rexfy.co>
# Changes per minute per user or IP (0 = no limit)
REXFY_RATE_LIMIT_WRITES_PER_MINUTE=60
# Error reporting (optional)
# REXFY_SENTRY_DSN=https://...@sentry.io/...
# Migrations against a pooled database (Neon) need the direct URL; Vercel's Neon integration
# sets DATABASE_URL and DATABASE_URL_UNPOOLED, which are read too.
# REXFY_DATABASE_URL_UNPOOLED=postgresql://...
